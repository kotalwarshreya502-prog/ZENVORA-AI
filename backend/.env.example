PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.psewugl.mongodb.net/zenvora_ai?retryWrites=true&w=majority
JWT_SECRET=your_strong_random_secret_min_32_chars
JWT_EXPIRE=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
EMAIL_FROM=noreply@zenvora.ai

# ── AI Model Providers (Configure at least one for genuine end-to-end LLM generation) ──
# 1. Google Gemini API (Recommended: 1M+ context, free tier available)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API (Optional: ultra-fast 300+ tok/s Llama 3.3 70B inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenAI or OpenRouter API (Optional)
# Get key: https://platform.openai.com/api-keys OR https://openrouter.ai/keys
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
